generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  GRANTS_OFFICER
  REVIEWER
}

enum FunderType {
  PUBLIC
  PHILANTHROPIC
  PRIVATE
  OTHER
}

enum ApplicationType {
  OPEN
  INVITED
  ROLLING
  STAGED
}

enum OpportunityStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum ApplicationStage {
  TRIAGE
  PREP
  REVIEW
  SUBMIT
  AWARDED
  REJECTED
}

enum ApplicationOutcome {
  UNKNOWN
  AWARDED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TemplateType {
  BOILERPLATE_1LINE
  BOILERPLATE_1PARA
  BOILERPLATE_1PAGE
  OUTREACH
  BUDGET
}

enum AttachmentCategory {
  BUDGET
  DRAFT
  SUPPORTING
  OTHER
}

enum RecommendedAction {
  PURSUE
  MONITOR
  NO_GO
}

enum RecordVisibility {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  SCORE_RUN
  SCORE_OVERRIDE
  LOGIN
  EXPORT_GENERATED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  OPPORTUNITY_IMPORT_CSV
  SCORING_RUN
  HARVEST_RUN
  EXPORT_PACKAGE
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  fundersCreated              Funder[]
  opportunitiesCreated        Opportunity[]
  applicationsOwned           Application[]        @relation("ApplicationOwner")
  tasksOwned                  ApplicationTask[]
  reviewsAuthored             ApplicationReview[]
  templatesCreated            Template[]
  templateUsages              TemplateUsage[]
  attachmentsUploaded         Attachment[]
  interactionsCreated         Interaction[]
  importJobsCreated           ImportJob[]
  fitScoringConfigUpdates     FitScoringConfig[]
  eligibilityRulesUpdates     EligibilityRules[]
  auditLogs                   AuditLog[]

  @@index([email])
  @@map("users")
}

model Funder {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  type        FunderType
  websiteUrl  String?     @map("website_url")
  description String?
  geographies String[]    @default([])
  tags        String[]    @default([])
  notes       String?
  createdById String      @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy      User            @relation(fields: [createdById], references: [id])
  opportunities  Opportunity[]
  contacts       Contact[]
  attachments    Attachment[]
  harvestSources HarvestSource[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
  @@map("funders")
}

model Opportunity {
  id                       String              @id @default(uuid()) @db.Uuid
  funderId                 String              @map("funder_id") @db.Uuid
  programName              String              @map("program_name")
  sourceUrl                String              @map("source_url")
  opportunityUrl           String?             @map("opportunity_url")
  status                   OpportunityStatus   @default(OPEN)
  lastFetched              DateTime?           @map("last_fetched") @db.Timestamptz
  declaredFocus            String[]            @default([]) @map("declared_focus")
  explicitExclusions       String?             @map("explicit_exclusions")
  geographies              String[]            @default([])
  eligibleApplicantTypes   String[]            @default([]) @map("eligible_applicant_types")
  minAward                 Decimal?            @map("min_award") @db.Decimal(14, 2)
  maxAward                 Decimal?            @map("max_award") @db.Decimal(14, 2)
  currency                 String?
  durationMonths           Int?                @map("duration_months")
  applicationType          ApplicationType     @map("application_type")
  deadlines                Json                @default("[]")
  reportingRequirements    String?             @map("reporting_requirements")
  processSteps             String[]            @default([]) @map("process_steps")
  description              String?             // Concise summary of opportunity (from scraper/harvest)
  rawDescription           String?             @map("raw_description") // Full unedited description from source
  aiFitScore               Decimal?            @map("ai_fit_score") @db.Decimal(3, 1)
  aiFitReasons             String[]            @default([]) @map("ai_fit_reasons")
  aiRecommendedAction      RecommendedAction?  @map("ai_recommended_action")
  aiConfidence             Decimal?            @map("ai_confidence") @db.Decimal(3, 2)
  manualFitScore           Decimal?            @map("manual_fit_score") @db.Decimal(3, 1)
  manualRecommendedAction  RecommendedAction?  @map("manual_recommended_action")
  manualFitRationale       String?             @map("manual_fit_rationale")
  visibility               RecordVisibility    @default(INTERNAL)
  tags                     String[]            @default([])
  createdById              String              @map("created_by_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  funder       Funder        @relation(fields: [funderId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  contacts     Contact[]
  applications Application[]
  attachments  Attachment[]
  embeddings   Embedding[]

  @@index([funderId])
  @@index([aiFitScore])
  @@index([tags], type: Gin)
  @@map("opportunities")
}

model Contact {
  id            String    @id @default(uuid()) @db.Uuid
  funderId      String?   @map("funder_id") @db.Uuid
  opportunityId String?   @map("opportunity_id") @db.Uuid
  name          String
  roleTitle     String?   @map("role_title")
  email         String?
  phone         String?
  notes         String?
  isPrimary     Boolean   @default(false) @map("is_primary")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  funder       Funder?       @relation(fields: [funderId], references: [id])
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id])
  interactions Interaction[]

  @@map("contacts")
}

model Application {
  id                      String             @id @default(uuid()) @db.Uuid
  opportunityId           String             @map("opportunity_id") @db.Uuid
  title                   String
  leadOwnerId             String             @map("lead_owner_id") @db.Uuid
  stage                   ApplicationStage
  outcome                 ApplicationOutcome @default(UNKNOWN)
  expectedAwardAmount     Decimal?           @map("expected_award_amount") @db.Decimal(14, 2)
  expectedCurrency        String?            @map("expected_currency")
  awardAmount             Decimal?           @map("award_amount") @db.Decimal(14, 2)
  awardCurrency           String?            @map("award_currency")
  aiFitScoreSnapshot      Decimal?           @map("ai_fit_score_snapshot") @db.Decimal(3, 1)
  aiFitReasonsSnapshot    String[]           @default([]) @map("ai_fit_reasons_snapshot")
  notes                   String?
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  opportunity     Opportunity          @relation(fields: [opportunityId], references: [id])
  leadOwner       User                 @relation("ApplicationOwner", fields: [leadOwnerId], references: [id])
  tasks           ApplicationTask[]
  reviews         ApplicationReview[]
  attachments     Attachment[]
  budget          Budget?
  interactions    Interaction[]
  templateUsages  TemplateUsage[]

  @@index([stage])
  @@index([leadOwnerId])
  @@map("applications")
}

model ApplicationTask {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  title         String
  description   String?
  ownerId       String      @map("owner_id") @db.Uuid
  status        TaskStatus  @default(TODO)
  category      String
  dueDate       DateTime?   @map("due_date") @db.Date
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  owner       User        @relation(fields: [ownerId], references: [id])

  @@map("application_tasks")
}

model ApplicationReview {
  id                       String   @id @default(uuid()) @db.Uuid
  applicationId            String   @map("application_id") @db.Uuid
  reviewerId               String   @map("reviewer_id") @db.Uuid
  decision                 String
  notes                    String?
  estimatedStaffHours      Decimal? @map("estimated_staff_hours") @db.Decimal(5, 2)
  requiresDirectorSignoff  Boolean  @default(false) @map("requires_director_signoff")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id])

  @@map("application_reviews")
}

model Template {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  type        TemplateType
  content     String
  tags        String[]     @default([])
  usageCount  Int          @default(0) @map("usage_count")
  isActive    Boolean      @default(true) @map("is_active")
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy User            @relation(fields: [createdById], references: [id])
  usages    TemplateUsage[]

  @@map("templates")
}

model TemplateUsage {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  usedById      String   @map("used_by_id") @db.Uuid
  usedAt        DateTime @default(now()) @map("used_at") @db.Timestamptz

  // Relations
  template    Template    @relation(fields: [templateId], references: [id])
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  usedBy      User        @relation(fields: [usedById], references: [id])

  @@map("template_usages")
}

model Attachment {
  id            String             @id @default(uuid()) @db.Uuid
  funderId      String?            @map("funder_id") @db.Uuid
  opportunityId String?            @map("opportunity_id") @db.Uuid
  applicationId String?            @map("application_id") @db.Uuid
  category      AttachmentCategory
  fileName      String             @map("file_name")
  mimeType      String             @map("mime_type")
  sizeBytes     BigInt             @map("size_bytes")
  storageKey    String             @map("storage_key")
  version       Int                @default(1)
  uploadedById  String             @map("uploaded_by_id") @db.Uuid
  uploadedAt    DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  funder       Funder?       @relation(fields: [funderId], references: [id])
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id])
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  budget       Budget?
  importJobs   ImportJob[]

  @@map("attachments")
}

model Budget {
  id              String   @id @default(uuid()) @db.Uuid
  applicationId   String   @unique @map("application_id") @db.Uuid
  csvAttachmentId String   @unique @map("csv_attachment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  csvAttachment Attachment  @relation(fields: [csvAttachmentId], references: [id])

  @@map("budgets")
}

model Interaction {
  id              String   @id @default(uuid()) @db.Uuid
  applicationId   String   @map("application_id") @db.Uuid
  contactId       String?  @map("contact_id") @db.Uuid
  interactionType String   @map("interaction_type")
  summary         String
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@map("interactions")
}

model FitScoringConfig {
  id               Int      @id @default(1)
  weightAlignment  Decimal  @default(0.5) @map("weight_alignment") @db.Decimal(3, 2)
  weightGeography  Decimal  @default(0.2) @map("weight_geography") @db.Decimal(3, 2)
  weightApplicantType Decimal @default(0.2) @map("weight_applicant_type") @db.Decimal(3, 2)
  weightAwardSize  Decimal  @default(0.1) @map("weight_award_size") @db.Decimal(3, 2)
  thresholdHigh    Decimal  @default(7.0) @map("threshold_high") @db.Decimal(3, 1)
  thresholdMedium  Decimal  @default(4.0) @map("threshold_medium") @db.Decimal(3, 1)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById      String?  @map("updated_by_id") @db.Uuid

  // Relations
  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("fit_scoring_config")
}

model EligibilityRules {
  id                    Int      @id @default(1)
  allowedGeographies    String[] @default([]) @map("allowed_geographies")
  allowedApplicantTypes String[] @default([]) @map("allowed_applicant_types")
  minAwardAmount        Decimal? @map("min_award_amount") @db.Decimal(14, 2)
  maxAwardAmount        Decimal? @map("max_award_amount") @db.Decimal(14, 2)
  currency              String?
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById           String?  @map("updated_by_id") @db.Uuid

  // Relations
  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("eligibility_rules")
}

model Embedding {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  embedding     Unsupported("vector")?
  modelName     String      @map("model_name")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("embeddings")
}

model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  jobType          JobType         @map("job_type")
  status           ImportJobStatus @default(PENDING)
  fileAttachmentId String?         @map("file_attachment_id") @db.Uuid
  createdById      String          @map("created_by_id") @db.Uuid
  startedAt        DateTime?       @map("started_at") @db.Timestamptz
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz
  errorMessage     String?         @map("error_message")
  summary          Json            @default("{}")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  fileAttachment Attachment? @relation(fields: [fileAttachmentId], references: [id])
  createdBy      User        @relation(fields: [createdById], references: [id])

  @@map("import_jobs")
}

model HarvestSource {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  baseUrl       String    @map("base_url")
  enabled       Boolean   @default(false)
  cronSchedule  String    @default("0 3 * * *") @map("cron_schedule")
  config        Json      @default("{}")
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  funderId      String?   @map("funder_id") @db.Uuid

  // Relations
  funder Funder? @relation(fields: [funderId], references: [id], onDelete: Cascade)

  @@map("harvest_sources")
}

model Catalogue {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  type             String
  focus            String[]  @default([])
  geographies      String[]  @default([])
  websiteUrl       String    @map("website_url")
  typicalAwardMin  Decimal?  @map("typical_award_min") @db.Decimal(14, 2)
  typicalAwardMax  Decimal?  @map("typical_award_max") @db.Decimal(14, 2)
  currency         String    @default("GBP")
  openData         String    @map("open_data") @default("No")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("catalogue")
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  action     AuditActionType
  entityType String          @map("entity_type")
  entityId   String?         @map("entity_id") @db.Uuid
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
