# App
APP_ENV=dev
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://grant_user:grant_pass_dev@localhost:5432/grant_manager?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grant-manager
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# JWT
JWT_SECRET=change-me-in-production-use-strong-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Embedding (placeholder for future)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
